<?xml version="1.0"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Nokido - allume le cerveau codeur llama-server (:8091) a la demande. La tache RESTE en cours tant que le serveur vit : son Job Object refuse la sortie (BREAKAWAY -&gt; WinError 5, mesure 2026-07-26), donc une action qui se termine tue le serveur avec elle. Pose aussi l'intention llama.wanted, sans quoi l'echelle d'eviction le reprend en moins d'une minute. Extinction : Nokido-Llama-Down, ou schtasks /End sur cette tache.</Description>
    <URI>\Nokido-Llama-Up</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>user</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>%USERPROFILE%\miniforge3\python.exe</Command>
      <Arguments>"%NOKIDO_ROOT%\tools\forge_llm_ondemand.py" up llama --fg</Arguments>
      <WorkingDirectory>%NOKIDO_ROOT%</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
