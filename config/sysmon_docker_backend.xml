<Sysmon schemaversion="4.90">
  <!-- RCA blocker Docker 2026-08-06 : nommer le process qui ouvre un handle
       TERMINATE sur com.docker.backend.exe (le tueur SIGTERM, si TerminateProcess).
       Install (console ADMIN) : sysmon64 -accepteula -i config/sysmon_docker_backend.xml
       Desinstall              : sysmon64 -u
       Lecture (owner) :
         Get-WinEvent Microsoft-Windows-Sysmon/Operational | ? Id -eq 10 |
           ? { $_.Message -match 'com.docker.backend.exe' } | fl TimeCreated, Message
       GrantedAccess 0x1 = PROCESS_TERMINATE. SourceImage = le tueur.
       NB : si le backend est arrete par un shutdown IPC (pas TerminateProcess),
       EID10 ne le voit pas -> la voie SCM du capteur Python prend le relais. -->
  <EventFiltering>
    <RuleGroup name="docker-backend-terminate" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="end with">com.docker.backend.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
    <ProcessCreate onmatch="exclude"/>
    <FileCreateTime onmatch="exclude"/>
    <NetworkConnect onmatch="exclude"/>
    <ProcessTerminate onmatch="exclude"/>
    <DriverLoad onmatch="exclude"/>
    <ImageLoad onmatch="exclude"/>
    <CreateRemoteThread onmatch="exclude"/>
    <RawAccessRead onmatch="exclude"/>
    <FileCreate onmatch="exclude"/>
    <RegistryEvent onmatch="exclude"/>
    <FileCreateStreamHash onmatch="exclude"/>
    <PipeEvent onmatch="exclude"/>
    <WmiEvent onmatch="exclude"/>
    <DnsQuery onmatch="exclude"/>
  </EventFiltering>
</Sysmon>
