# Nokido AI Agent — sample.env
# Copy to Nokido.env and fill in your values
#
# Nokido runs locally (llama.cpp GPU / Ollama CPU) with optional cloud cascade
# (Gemini / OpenRouter / HuggingFace / GitHub / Groq). Same agent code,
# same API, same MCP server.

# ── OPTION 1: Local GPU (llama.cpp Vulkan/CUDA/Metal — fastest) ──────────────
# Start llama-server:
#   ./llama-server -m qwen2.5-coder-7b-q4_k_m.gguf --host 127.0.0.1 --port 8080 -ngl 99 -c 4096
# Then enable by uncommenting below — Nokido routes all silos to this endpoint.
# LAFORGE_LLM_ENDPOINT=http://127.0.0.1:8080/v1

# ── OPTION 2: Local CPU (Ollama — simplest) ──────────────────────────────────
# Install Ollama: https://ollama.com
# Then: ollama pull qwen2.5-coder:7b
# Used automatically if LAFORGE_LLM_ENDPOINT is unset.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL_DEFAULT=qwen2.5-coder:7b

# ── OPTION 3: Cloud cascade (free tiers — fallback if local saturated) ───────
# Any combination of these can be enabled. `call_cascade()` iterates until one
# responds successfully. Ideal for CTF, recon, or long-running sessions.
#
# Provider API keys belong in the machine vault (app/forge_secrets.py), NEVER
# in plaintext .env files:
#   nokido-secrets set --key <KEY_NAME>
#   # or from a clone: python app/forge_secrets.py set --key <KEY_NAME>
#   # Status check:    nokido-secrets status
#
# Supported provider keys (stored in vault, read via forge_secrets.get_secret):
# - Google Gemini (gemini-2.0-flash, gemini-2.5-flash) — https://aistudio.google.com/apikey
#     nokido-secrets set --key GEMINI_API_KEY
# - OpenRouter (free models — Claude, Llama, DeepSeek, Qwen...) — https://openrouter.ai/keys
#     nokido-secrets set --key OPENROUTER_API_KEY
# - HuggingFace Inference API — https://huggingface.co/settings/tokens
#     nokido-secrets set --key HF_TOKEN
# - GitHub Models (free tier, gpt-4o-mini / Llama / Mistral) — github.com/settings/tokens
#     nokido-secrets set --key GITHUB_TOKEN
# - Groq (very fast inference, free tier) — https://console.groq.com
#     nokido-secrets set --key GROQ_API_KEY

# ── OPTION 4: Custom LiteLLM proxy ───────────────────────────────────────────
# Route via any LiteLLM-compatible endpoint (store LITELLM_API_KEY via `nokido-secrets set --key LITELLM_API_KEY`)
# LITELLM_MODEL=ollama/qwen2.5-coder:7b
# LITELLM_API_BASE=http://127.0.0.1:11434

# ── MCP & Multi-Agent Bridge ─────────────────────────────────────────────────
# Token HMAC pour le Hub HTTP (capability tokens, audit crypto) :
#   python -c "import secrets; print(secrets.token_hex(32))"
#   nokido-secrets set --key FORGE_MCP_TOKEN

# ── Git push (optional — Codeberg mirror) ────────────────────────────────────
# Create token at codeberg.org/user/settings/applications, then store in vault:
#   nokido-secrets set --key CODEBERG_TOKEN
