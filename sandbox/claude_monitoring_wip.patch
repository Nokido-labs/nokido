+def parse_excel(path):
+    """
+    Parse un fichier .xlsx sans openpyxl (via zip + xml).
+    Cherche a extraire une liste d'equipements.
+    """
+    from xml.etree import ElementTree as ET
+    path = Path(path)
+    
+    with zipfile.ZipFile(path, 'r') as z:
+        # 1. Charger les shared strings (les textes)
+        strings = []
+        if 'xl/sharedStrings.xml' in z.namelist():
+            with z.open('xl/sharedStrings.xml') as f:
+                tree = ET.parse(f)
+                for t in tree.findall('.//{http://schemas.openxmlformats.org/spreadsheetml/2006/main}t'):
+                    strings.append(t.text)
+        
+        # 2. Charger la feuille 1
+        with z.open('xl/worksheets/sheet1.xml') as f:
+            tree = ET.parse(f)
+            rows = []
+            ns = {'ns': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}
+            for row_node in tree.findall('.//ns:row', ns):
+                row_data = []
+                for cell in row_node.findall('ns:c', ns):
+                    val_node = cell.find('ns:v', ns)
+                    if val_node is not None:
+                        val = val_node.text
+                        # Si type 's', c'est un index dans sharedStrings
+                        if cell.get('t') == 's':
+                            val = strings[int(val)] if int(val) < len(strings) else ""
+                        row_data.append(val)
+                    else:
+                        row_data.append(None)
+                if any(row_data):
+                    rows.append(row_data)
+
+    if not rows:
+        raise VisioParseError("Fichier Excel vide ou illisible.")
+
+    # 3. Mapping intelligent des colonnes
+    # On cherche la ligne de header (celle qui a le plus de mots-clés reconnus)
+    header_idx = 0
+    best_score = -1
+    keywords_all = ['host', 'nom', 'name', 'appareil', 'ip', 'mgmt', 'adresse', 'vendor', 'constructeur', 'marque', 'type', 'serial', 'asset']
+    
+    for i in range(min(5, len(rows))):
+        score = sum(1 for c in rows[i] if any(k in str(c).lower() for k in keywords_all))
+        if score > best_score:
+            best_score = score
+            header_idx = i
+            
+    header = [str(c).lower() if c else "" for c in rows[header_idx]]
+    
+    def find_col(keywords):
+        for i, h in enumerate(header):
+            if any(k in h for k in keywords): return i
+        return -1
+
+    idx_host = find_col(['host', 'nom', 'name', 'appareil', 'displayed text'])
+    idx_ip = find_col(['ip', 'mgmt', 'adresse'])
+    idx_vendor = find_col(['vendor', 'constructeur', 'marque', 'type', 'manufacturer'])
+    idx_role = find_col(['role', 'fonction'])
+    idx_model = find_col(['model', 'modele', 'ref', 'product number'])
+    idx_sn = find_col(['serial', 's/n'])
+    idx_asset = find_col(['asset', 'étiquette'])
+
+    if idx_host == -1:
+        # Fallback: si on trouve pas 'host', on essaye de prendre la première colonne non vide qui n'est pas IP
+        idx_host = 0
+
+    equipment = []
+    # On commence après le header
+    for i, r in enumerate(rows[header_idx+1:]):
+        # On saute les lignes vides
+        if not any(r): continue
+        
+        # On essaye de trouver un nom. Si r[idx_host] est vide, on tente r[idx_model] ou un nom générique
+        hostname = str(r[idx_host]) if idx_host < len(r) and r[idx_host] else ""
+        if not hostname and idx_model != -1 and idx_model < len(r) and r[idx_model]:
+            hostname = str(r[idx_model])
+        if not hostname:
+            hostname = f"EQUIP-{i+1}"
+
+        # On stocke toutes les colonnes brutes dans 'props' pour enrichissement
+        props = {}
+        for j, val in enumerate(r):
+            if j < len(header) and header[j]:
+                props[header[j]] = val
+
+        equipment.append({
+            "shape_id": f"xl_{i}",
+            "hostname": hostname,
+            "mgmt_ip": str(r[idx_ip]) if idx_ip != -1 and idx_ip < len(r) and r[idx_ip] else "0.0.0.0",
+            "vendor_key": str(r[idx_vendor]).lower().replace(" ", "_") if idx_vendor != -1 and idx_vendor < len(r) and r[idx_vendor] else "_generic",
+            "model": str(r[idx_model]) if idx_model != -1 and idx_model < len(r) and r[idx_model] else "",
+            "serial_number": str(r[idx_sn]) if idx_sn != -1 and idx_sn < len(r) and r[idx_sn] else None,
+            "asset_tag": str(r[idx_asset]) if idx_asset != -1 and idx_asset < len(r) and r[idx_asset] else None,
+            "role": str(r[idx_role]).lower() if idx_role != -1 and idx_role < len(r) and r[idx_role] else "access",
+            "page_id": "p_excel",
+            "properties": props # On garde TOUT le contenu XLSX ici
+        })
+
+    return {
+        "schema": "netcfg-network-v2",
+        "site": f"Import Excel: {path.name}",
+        "vlans": [{"id": 1, "name": "default"}],
+        "pages": [{"id": "p_excel", "name": "Inventaire Excel", "width": 1000, "height": 800}],
+        "equipment": equipment,
+        "links": [],
+        "ports": [],
+        "racks": []
