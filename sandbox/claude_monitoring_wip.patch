+# ============================================================================
+# HostTelemetry (machines, serveurs, appliances)
+# ============================================================================
+
+
+class HostTelemetry:
+    """Etat telemetrique d un host non-switch (serveur, NAS, printer, appliance).
+
+    Differences avec SwitchTelemetry :
+      - pas de temp (machines server ont souvent plusieurs capteurs mais pas expose)
+      - metriques systeme (disk, IOPS, services)
+      - network par interface virtuelle (eth0/eth1/lo)
+      - pas de ports physiques
+    """
+
+    MAX_POINTS = 60
+
+    def __init__(self, hostname: str, host_type: str = "server", os: str = "linux"):
+        self.hostname = hostname
+        self.host_type = host_type  # server | nas | printer | appliance | iot
+        self.os = os  # linux | windows | embedded
+
+        # Baselines par type
+        baseline = {
+            "server":    {"cpu": 22, "mem": 55, "disk": 45, "net": 180, "iops": 120},
+            "nas":       {"cpu": 8,  "mem": 35, "disk": 72, "net": 450, "iops": 340},
+            "printer":   {"cpu": 3,  "mem": 22, "disk": 8,  "net": 2,   "iops": 2},
+            "appliance": {"cpu": 15, "mem": 40, "disk": 30, "net": 80,  "iops": 60},
+            "iot":       {"cpu": 5,  "mem": 28, "disk": 12, "net": 4,   "iops": 5},
+        }.get(host_type, {"cpu": 10, "mem": 30, "disk": 25, "net": 50, "iops": 30})
+
+        self._baseline = baseline
+        self._phase = random.uniform(0, 2 * math.pi)
+
+        # Series temporelles
+        self.cpu_percent = deque(maxlen=self.MAX_POINTS)
+        self.mem_percent = deque(maxlen=self.MAX_POINTS)
+        self.temp_celsius = deque(maxlen=self.MAX_POINTS)
+        self.disk_percent = deque(maxlen=self.MAX_POINTS)
+        self.net_in_mbps = deque(maxlen=self.MAX_POINTS)
+        self.net_out_mbps = deque(maxlen=self.MAX_POINTS)
+        self.iops = deque(maxlen=self.MAX_POINTS)
+        self.timestamps = deque(maxlen=self.MAX_POINTS)
+
+        self.status = "up"
+        self.last_seen = datetime.datetime.now().isoformat()
+        self.uptime_seconds = random.randint(86400, 86400 * 180)
+
+        # Services simules (pertinent pour servers)
+        self.services = self._init_services()
+
+        # User sessions (pertinent pour servers/nas)
+        self.active_sessions = random.randint(0, 8) if host_type in ("server", "nas") else 0
+
+        # Last backup (NAS uniquement)
+        if host_type == "nas":
+            hours_ago = random.randint(1, 48)
+            self.last_backup = (datetime.datetime.now() -
+                                datetime.timedelta(hours=hours_ago)).isoformat()
+        else:
+            self.last_backup = None
+
+    def _init_services(self):
+        """Services plausibles par type."""
+        services_map = {
+            "server": ["sshd", "nginx", "postgresql", "redis", "systemd-journald"],
+            "nas":    ["sshd", "smbd", "nfs-kernel-server", "rsnapshot", "snmpd"],
+            "printer": ["httpd-cups", "snmpd"],
+            "appliance": ["sshd", "nginx", "telemetry-agent"],
+            "iot":    ["sensor-agent", "mqtt-client"],
+        }
+        names = services_map.get(self.host_type, ["sshd"])
+        return [
+            {"name": n, "state": random.choices(["active", "inactive"], weights=[92, 8])[0]}
+            for n in names
+        ]
+
+    def tick(self, elapsed_s: float):
+        t = datetime.datetime.now()
+        b = self._baseline
+        wave = math.sin((elapsed_s / 40) + self._phase)
+        noise = random.gauss(0, 2)
+
+        cpu = max(1, min(96, b["cpu"] + wave * 12 + noise * 3))
+        mem = max(10, min(94, b["mem"] + wave * 4 + noise * 1.5))
+        # Disk croit lentement (drift positif)
+        disk = max(5, min(98, b["disk"] + wave * 1.5 + noise * 0.5))
+        net_in = max(0.1, b["net"] + wave * b["net"] * 0.5 + noise * 8)
+        net_out = max(0.1, b["net"] * 0.6 + wave * b["net"] * 0.3 + noise * 6)
+        iops_val = max(0, int(b["iops"] + wave * b["iops"] * 0.4 + noise * 10))
+
+        self.cpu_percent.append(round(cpu, 1))
+        self.mem_percent.append(round(mem, 1))
+        self.disk_percent.append(round(disk, 1))
+        self.net_in_mbps.append(round(net_in, 2))
+        self.net_out_mbps.append(round(net_out, 2))
+        self.iops.append(iops_val)
+        self.timestamps.append(t.isoformat(timespec="seconds"))
+
+        if cpu > 85 or mem > 88 or disk > 92:
+            self.status = "warn"
+        elif cpu > 93 or mem > 95 or disk > 97:
+            self.status = "down"
+        else:
+            self.status = "up"
+        self.last_seen = t.isoformat()
+        self.uptime_seconds += elapsed_s
+
+        # Occasionally flip a service
+        if random.random() < 0.005 and self.services:  # 0.5% par tick
+            svc = random.choice(self.services)
+            svc["state"] = "active" if svc["state"] == "inactive" else "inactive"
+
+    def snapshot(self) -> dict:
+        return {
+            "hostname": self.hostname,
+            "host_type": self.host_type,
+            "os": self.os,
+            "status": self.status,
+            "last_seen": self.last_seen,
+            "uptime_seconds": self.uptime_seconds,
+            "current": {
+                "cpu_percent": self.cpu_percent[-1] if self.cpu_percent else 0,
+                "mem_percent": self.mem_percent[-1] if self.mem_percent else 0,
+                "temp_celsius": self.temp_celsius[-1] if self.temp_celsius else 0,
+                "disk_percent": self.disk_percent[-1] if self.disk_percent else 0,
+                "net_in_mbps": self.net_in_mbps[-1] if self.net_in_mbps else 0,
+                "net_out_mbps": self.net_out_mbps[-1] if self.net_out_mbps else 0,
+                "iops": self.iops[-1] if self.iops else 0,
+            },
+            "series": {
+                "timestamps": list(self.timestamps),
+                "cpu": list(self.cpu_percent),
+                "mem": list(self.mem_percent),
+                "disk": list(self.disk_percent),
+                "net_in": list(self.net_in_mbps),
+                "net_out": list(self.net_out_mbps),
+                "iops": list(self.iops),
+            },
+            "services": self.services,
+            "active_sessions": self.active_sessions,
+            "last_backup": self.last_backup,
+        }
