+.rack-asset { position: absolute; left: 2px; right: 2px; background: #2a2a2a; border: 1px solid #444; border-radius: 2px; display: flex; align-items: center; padding: 0 10px; cursor: pointer; transition: transform 0.1s, box-shadow 0.1s; }
+.rack-asset:hover { transform: scale(1.01); box-shadow: 0 0 8px rgba(255,255,255,0.1); z-index: 10; }
+.rack-asset-info { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
+.rack-asset-info .name { font-size: 10px; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
+.rack-asset-info .meta { font-size: 8px; color: #888; text-transform: uppercase; }
+.rack-asset-status { margin-left: 8px; }
+.rack-asset.core { background: #2d2d3a; }
+.rack-asset.server { background: #1a2a1a; }
