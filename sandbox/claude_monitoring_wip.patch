+def _load_hf_token() -> str | None:
+    """Recupere HF_TOKEN depuis l env ou Nokido.env."""
+    tok = os.environ.get("HF_TOKEN", "").strip()
+    if tok:
+        return tok
+    # Fallback : lire depuis Nokido.env si present
+    lf_env = Path(r"%NOKIDO_WORKSPACE%\LaForge\LaForge.env")
+    if lf_env.is_file():
+        for line in lf_env.read_text(encoding="utf-8").split("\n"):
+            line = line.strip()
+            if line.startswith("HF_TOKEN"):
+                parts = line.split("=", 1)
+                if len(parts) == 2:
+                    tok = parts[1].strip().strip('"').strip("'")
+                    # Stripper commentaires inline
+                    if "#" in tok:
+                        tok = tok.split("#")[0].strip()
+                    if tok:
+                        return tok
+    return None
+
