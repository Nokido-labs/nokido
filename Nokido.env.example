# Nokido.env.example — Copier vers Nokido.env et renseigner les valeurs
# cp Nokido.env.example Nokido.env  (Linux/Mac)
# copy Nokido.env.example Nokido.env  (Windows)

# ── Ollama (modèle de chat local) ────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
OLLAMA_EMBEDDINGS_URL=http://localhost:11434/api/embed
OLLAMA_MODEL_DEFAULT=qwen2.5-coder:latest
OLLAMA_EMBEDDINGS_MODEL=bge-m3

# ── RAG ──────────────────────────────────────────────────────────────────────
USE_RAG=true
RAG_DOCS_TOPK=5
RAG_DIR=

# ── MCP Sécurité ─────────────────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
FORGE_MCP_TOKEN=votre_token_secret_ici
MCP_RATE_LIMIT=60
MCP_MAX_PAYLOAD_KB=512
MCP_STRICT_MODE=false
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1
MCP_LOG_LEVEL=info
MCP_ENABLE_RESOURCES=true
MCP_ENABLE_PROMPTS=true

# ── SSH (optionnel — pour @ssh et @scan) ─────────────────────────────────────
SSH_HOST=
SSH_USER=
SSH_PORT=22
PRIVATE_KEY_PATH=

# ── Performances ─────────────────────────────────────────────────────────────
VERBOSE=false
MAX_CONCURRENT_OLLAMA=2
CHUNK_OVERLAP_WORDS=30
EMBED_BATCH_SIZE=16

# ── NPU/ONNX (optionnel — chemins modèles) ───────────────────────────────────
MODELS_NPU_DIR=models/npu
MINILM_BASE_ONNX=models/npu/minilm_base.onnx
MODEL_QUANTIZED_NPU=models/npu/model_quantized_npu.onnx
MINILM_NPU_QUARK=models/npu/minilm_npu_quark_int8.onnx

# ── LiteLLM fallback (collab multi-agents) ───────────────────────────────────
LITELLM_MODEL=ollama/qwen2.5
LITELLM_API_BASE=http://localhost:11434
LITELLM_API_KEY=

# ── Timezone ─────────────────────────────────────────────────────────────────
# Offset UTC→heure locale (1 = UTC+1 Paris, 0 = UTC)
TZ_OFFSET=1

# ── Environnement ────────────────────────────────────────────────────────────
# dev  → logging LLM dans shared_prompt_log, @chat disponible
# prod → silence total (défaut sécurisé)
LAFORGE_ENV=prod

# ── Loop automerge ───────────────────────────────────────────────────────────
LOOP_AUTOMERGE=false
LOOP_AUTOMERGE_MIN_DELTA=1
LOOP_AUTOMERGE_MIN_QUALITY=60
