Screen { background: #0d1117; }
/* ── Layout principal : sidebar fixe + zone centrale ajustable ── */
#main-layout { layout: horizontal; width: 100%; height: 100%; }
#sidebar { width: 24; background: #161b22;
           border-right: solid #21262d; padding: 0 1; overflow-y: auto; min-width: 20; }
#sidebar.hidden-sidebar { display: none; }
/* Zone chat+terminal côte à côte, séparateur draggable */
#center-layout { layout: horizontal; width: 1fr; height: 100%; }
#chat-panel { width: 1fr; min-width: 30; background: #0d1117;
              layout: vertical; padding: 0; }
/* Séparateur vertical ajustable entre chat et terminal */
#v-splitter {
    width: 1; background: #21262d;
}
#v-splitter:hover { background: #388bfd40; }
#terminal-panel { width: 1fr; min-width: 20; background: #0a0e14; layout: vertical; }
/* Mode sans SSH : terminal+splitter masqués, chat occupe tout le center-layout */
#terminal-panel.hidden { display: none; }
#v-splitter.hidden     { display: none; }
#term-title.hidden     { display: none; }
/* chat-panel.expanded : prend tout le center-layout */
#chat-panel.expanded   { width: 1fr; }
/* Bandeau no-ssh : ligne discrète en bas de la zone chat */
#no-ssh-banner { height: 1; background: #161b22; color: #484f58;
                 border-top: solid #21262d; padding: 0 1; display: none; }
#no-ssh-banner.visible { display: block; }
#chat-log { height: 1fr; background: #0d1117; padding: 0 1;
           scrollbar-size: 1 1; scrollbar-color: #30363d; scrollbar-color-hover: #58a6ff; }
/* Input auto-expand 1→6 lignes */
#chat-input { height: auto; min-height: 1; max-height: 6;
              background: #0d1117; color: #c9d1d9;
              border: solid #30363d;
              scrollbar-size: 0 0; }
#chat-input:focus { border: solid #58a6ff; }
#input-bar { height: auto; min-height: 3; background: #161b22;
             border-top: solid #21262d; padding: 0 1; }
#chat-title { height: 1; background: #161b22; color: #58a6ff; padding: 0 1; }
#chat-title-bar { height: 1; background: #161b22; border-bottom: solid #21262d; }
.copy-btn { width: 3; height: 1; background: #161b22; color: #8b949e;
            padding: 0 1; content-align: center middle; }
.copy-btn:hover { color: #58a6ff; }
#term-title { height: 1; background: #0f2419; color: #3fb950; padding: 0 1; border-bottom: solid #238636; }
PTYTerminal { height: 1fr; width: 100%; background: #0a0e14; color: #adbac7;
              overflow-y: scroll; padding: 0; min-width: 40; }
#pty-log { width: 100%; overflow-y: scroll;
           scrollbar-size: 1 1; scrollbar-color: #30363d;
           scrollbar-color-hover: #58a6ff; }
#ai-status { height: 1; color: #8b949e; padding: 0 1; }
#sidebar-title { height: auto; color: #58a6ff; margin-bottom: 1; }
/* ── SkillTree Agentic ──────────────────────────────── */
SkillTreePanel { height: auto; min-height: 3; max-height: 16; padding: 0 1;
                 border: solid #21262d; background: #0d1117; overflow-y: auto; }
SkillNode { height: 1; }
#skill-title { color: #a371f7; height: 1; }
#sess-label { height: 1; color: #8b949e; margin-top: 1; }
#session-list { height: auto; max-height: 6; border: solid #21262d; background: #0d1117; margin-bottom: 1; }
ListView > ListItem { padding: 0 1; height: 1; }
ListView > ListItem:hover { background: #21262d; }
ListView > ListItem.--highlight { background: #21262d; }
.sb-section-label { height: 1; color: #8b949e; margin-top: 1; }
.sb-btn { height: 1; background: #21262d; color: #c9d1d9; border: none; min-width: 1; margin: 0; }
.sb-btn:hover { background: #30363d; color: #ffffff; }
/* ── Orchestrateur mode selector ── */
#orc-title { height: 1; color: #58a6ff; text-style: bold; text-align: center; margin-top: 0; }
#orc-version { height: 1; color: #8b949e; text-align: center; margin-bottom: 1; }
.mode-btn { height: 1; border: none; margin: 0; width: 100%; min-width: 8; overflow: hidden hidden; }
#btn-mode-autonome { color: #79c0ff; background: #0d1f33; }
#btn-mode-ping     { color: #56d364; background: #0d2010; }
#btn-mode-chef     { color: #ffa657; background: #2d1b00; }
#btn-mode-debat    { color: #d2a8ff; background: #1f1030; }
#btn-mode-cline    { color: #ff7b72; background: #2d0a0a; }
#btn-sudo-toggle   { color: #79c0ff; background: #0d1f33; }
#btn-mode-autonome.-active { color: #ffffff; background: #1a3a5c; text-style: bold; }
#btn-mode-ping.-active     { color: #ffffff; background: #1a3d18; text-style: bold; }
#btn-mode-chef.-active     { color: #ffffff; background: #3d2800; text-style: bold; }
#btn-mode-debat.-active    { color: #ffffff; background: #3a1a5c; text-style: bold; }
#btn-mode-cline.-active    { color: #ffffff; background: #5c1a1a; text-style: bold; }
/* ── Séparateur rôles ── */
.sb-sep { height: 1; color: #30363d; }
RoleLightPanel { height: auto; }
/* ── Agents ── */
.agent-btn { color: #e6edf3; }
.agent-btn:hover { color: #ffffff; }
#prog-label { height: 1; color: #8b949e; }
ProgressBar { margin: 0; height: 1; }
#confirm-box { width: 60; background: #161b22; border: solid #ff7b72; padding: 2; align: center middle; }
#confirm-message { color: #e6edf3; margin-bottom: 1; }

/* ── Modal Screens ── */
SSHWizardScreen { align: center middle; background: rgba(0,0,0,0.85); }
#wizard-box { width: 64; background: #161b22; border: solid #58a6ff; padding: 1 2; }

ModelScreen { align: center middle; background: rgba(0,0,0,0.75); }
#model-box { width: 64; max-height: 30; background: #0d1117; border: solid #388bfd; padding: 1 2; overflow-y: auto; }
#model-title { color: #58a6ff; text-style: bold; margin-bottom: 1; }
#model-hint { color: #8b949e; margin-bottom: 1; }
.model-item { color: #e6edf3; background: #161b22; height: 1; padding: 0 1; }

NotificationScreen { align: center middle; background: rgba(0,0,0,0.7); }
#notification-box { width: 54; background: #161b22; border: solid #58a6ff; padding: 1 2; }
#notification-message { margin-bottom: 1; color: #c9d1d9; }
