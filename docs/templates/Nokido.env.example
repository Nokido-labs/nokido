# =============================================================================
# La Forge v13 — Configuration (TEMPLATE)
# =============================================================================
# Copier ce fichier en Nokido.env et remplir les valeurs.
# Nokido.env est dans .gitignore — ne JAMAIS committer vos credentials.
#
#   cp Nokido.env.example Nokido.env
#   # puis éditer Nokido.env avec vos vraies valeurs
# =============================================================================

# ── Connexion SSH ──────────────────────────────────────────────────────────────
SSH_HOST=192.168.1.XXX
SSH_PORT=22
SSH_USER=votre_user
# Chemin absolu vers votre clé privée SSH (format OpenSSH)
PRIVATE_KEY_PATH=C:\Users\VotreNom\.ssh\id_rsa
# ou sous Linux/Mac :
# PRIVATE_KEY_PATH=/home/vous/.ssh/id_rsa

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
OLLAMA_EMBEDDINGS_URL=http://localhost:11434/api/embed
# Modèle par défaut au démarrage
OLLAMA_MODEL_DEFAULT=qwen2.5-coder:latest
# Modèle d'embeddings (bge-m3 recommandé, nomic-embed-text en fallback)
OLLAMA_EMBEDDINGS_MODEL=bge-m3

# ── Performances ──────────────────────────────────────────────────────────────
VERBOSE=false
# Nombre d'appels Ollama simultanés (2 recommandé sur 16 Go RAM)
MAX_CONCURRENT_OLLAMA=2
CHUNK_SIZE_TARGET=400
CHUNK_OVERLAP_WORDS=30
EMBED_BATCH_SIZE=16

# ── RAG ───────────────────────────────────────────────────────────────────────
USE_RAG=true
RAG_DOCS_TOPK=5
# Laisser vide pour utiliser data/rag_files/ automatiquement
RAG_DIR=

# ── Commandes SSH ─────────────────────────────────────────────────────────────
MAX_COMMAND_RETRIES=2
COMMAND_RETRY_DELAY=2

# ── Boucle d'auto-amélioration (@loop) ────────────────────────────────────────
# false = demande confirmation après chaque cycle (recommandé)
# true  = fusionne automatiquement si les seuils sont atteints (mode nuit)
LOOP_AUTOMERGE=false
# Nombre minimum d'erreurs éliminées pour déclencher l'automerge
LOOP_AUTOMERGE_MIN_DELTA=1
# Score qualité minimum (sur 100) pour l'automerge
LOOP_AUTOMERGE_MIN_QUALITY=60
