#!/usr/bin/env python
# Nokido gate — pre-commit. Route vers le filtre CENTRAL forge_git_gate.
# Secrets = BLOCK (fail-closed). Désync + qualité = WARN. Anti-perte : ne bloque
# QUE les secrets (jamais empêcher de SAUVER en local = ne pas perdre le travail).
# Python (pas de bash requis : compat LaForgeSbxOffline, comme l'ancien hook).
import os
import subprocess
import sys

root = subprocess.run(
    ["git", "rev-parse", "--show-toplevel"],
    capture_output=True, text=True, encoding="utf-8",
).stdout.strip()
gate = os.path.join(root, "tools", "forge_git_gate.py")
if not gate or not os.path.exists(gate):
    sys.exit(0)  # filtre absent = ne pas bloquer la sauvegarde
env = dict(os.environ)
env["PYTHONPATH"] = os.pathsep.join(
    [os.path.join(root, "app"), os.path.join(root, "tools"), env.get("PYTHONPATH", "")]
)
sys.exit(subprocess.run(
    ["%USERPROFILE%/miniforge3/python.exe", gate, "precommit"], cwd=root, env=env
).returncode)
