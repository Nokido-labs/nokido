#!/usr/bin/env python
# Nokido gate — prepare-commit-msg. Injecte le trailer X-Agent / X-Agent-Channel
# (identité de l'agent qui commit). Auteur git reste user (JAMAIS Co-Authored-By).
# Jamais bloquant (un échec de trailer ne doit pas empêcher de SAUVER).
import os
import subprocess
import sys

# --- sans fenetre (owner 3/11 : « git n'arrete pas de faire poper des terminaux ») : sous Windows, tout
# sous-processus de ce hook part en CREATE_NO_WINDOW ; les petits-enfants (gate, git) heritent d'une console SANS
# fenetre. Le drapeau d'un appelant est respecte. NR tests/nr/test_githooks_sans_fenetre_nr.py
if os.name == "nt":
    class _PopenSansFenetre(subprocess.Popen):
        def __init__(self, *a, **k):
            k.setdefault("creationflags", getattr(subprocess, "CREATE_NO_WINDOW", 0x08000000))
            # sans fenetre, l'enfant ecrirait dans SA console cachee (messages du gate perdus, 672d52764)
            for _nom, _flux in (("stdout", sys.stdout), ("stderr", sys.stderr)):
                if k.get(_nom) is None and _flux is not None:
                    k[_nom] = _flux
            super().__init__(*a, **k)

    subprocess.Popen = _PopenSansFenetre
# --- fin sans fenetre

root = subprocess.run(
    ["git", "rev-parse", "--show-toplevel"],
    capture_output=True, text=True, encoding="utf-8",
).stdout.strip()
gate = os.path.join(root, "tools", "forge_git_gate.py")
msg = sys.argv[1] if len(sys.argv) > 1 else ""
if msg and os.path.exists(gate):
    env = dict(os.environ)
    env["PYTHONPATH"] = os.pathsep.join(
        [os.path.join(root, "app"), os.path.join(root, "tools"), env.get("PYTHONPATH", "")]
    )
    try:
        subprocess.run(
            ["%USERPROFILE%/miniforge3/python.exe", gate, "prepare-msg", msg],
            cwd=root, env=env,
        )
    except Exception:
        pass
sys.exit(0)
